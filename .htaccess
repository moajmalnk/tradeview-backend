# Hostinger: subdomain document root is this folder (not /public).
# Rewrite all app traffic into public/ and block sensitive paths.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Never expose secrets or source
  RewriteRule ^(src|config|database|vendor|storage)(/|$) - [F,L]
  RewriteRule ^\.env - [F,L]
  RewriteRule ^composer\.(json|lock)$ - [F,L]
  RewriteRule ^\.git - [F,L]

  # Already inside /public — let public/.htaccess handle it
  RewriteRule ^public/ - [L]

  # Send everything else to the front controller tree
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
